<style>
body { font-family: 'Calibri', sans-serif; }
h1 { color: #2E74B5; border-bottom: 2px solid #2E74B5; padding-bottom: 5px; }
h2 { color: #F57F20; margin-top: 20px; }
h3 { color: #444444; }
ul { margin-bottom: 15px; }
li { margin-bottom: 5px; }
.advertencia { background-color: #FFF2CC; border-left: 4px solid #FFC000; padding: 10px; margin-top: 5px; font-style: italic; }
.exito { background-color: #E2EFDA; border-left: 4px solid #70AD47; padding: 10px; margin-top: 5px; font-style: italic; }
.error { background-color: #FCE4D6; border-left: 4px solid #ED7D31; padding: 10px; margin-top: 5px; font-style: italic; }
